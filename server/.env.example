# cp .env.example .env 로 복사해 씁니다. .env는 커밋하지 않습니다.
# 아래 기본값은 API 키 없이 도는 테스트 모드입니다(.txt를 녹취로 간주, 키워드 판정).

# 판정: rule | anthropic | openai | bedrock
GUARD_LLM=rule
# 음성 변환: text | server | openai | transcribe
GUARD_STT=text

# GUARD_STT=server일 때 쓰는 자체 STT 서버
# STT_BASE_URL=
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
# STT_TIMEOUT=900
# STT_MAX_RETRIES=3
# STT_QUEUE_TIMEOUT=60
# 자체 STT를 못 쓸 때 대체 경로: openai | none. openai면 음성이 OpenAI로 전송되고 OPENAI_API_KEY가 필요합니다.
# STT_FALLBACK=openai

# 실제 분석에 필요한 키
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GUARD_OPENAI_MODEL=

# 음성 저장: local | s3
# GUARD_STORAGE=s3
# GUARD_S3_BUCKET=
# GUARD_S3_REGION=
# GUARD_KEEP_AUDIO=0

# 안드로이드 앱과 업로드 링크가 쓰는 서버 주소
# GUARD_PUBLIC_BASE_URL=http://localhost:8091

# 사기 사례 검색 서버 (비우면 LLM만으로 판정)
# GUARD_RAG_URL=
# GUARD_RAG_API_KEY=

# 임계값
# GUARD_ALERT_THRESHOLD=0.7
# GUARD_LOCK_THRESHOLD=0.9

# 웹 시연 가족. 운영에서는 0
# GUARD_DEMO_FAMILY=1

# 처리 시간과 토큰 관측 (통화 내용은 보내지 않음)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
